---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import MapView from '../components/MapView.tsx';
import { getPosts, toPin } from '../lib/posts';
import { SITE } from '../consts';

const posts = await getPosts();
const [featured, ...rest] = posts;
const pins = posts.map((p) => toPin(p)).filter((p) => p !== null);

const regions = new Set(pins.map((p) => p.region));
const stats = [
  { icon: 'fa6-solid:landmark', label: '답사', value: posts.filter((p) => p.data.kind === '유산').length },
  { icon: 'fa6-solid:building-columns', label: '전시', value: posts.filter((p) => p.data.kind === '전시').length },
  { icon: 'fa6-solid:map-location-dot', label: '시·도', value: regions.size },
];
---

<Base wide>
  <section class="max-w-(--container-measure) mx-auto">
    <h1 class="font-serif text-3xl font-extrabold tracking-tight">{SITE.title}</h1>
    <p class="mt-2 text-ink-soft">{SITE.tagline}</p>

    <dl class="mt-6 flex gap-6 flex-wrap">
      {
        stats.map((s) => (
          <div class="flex items-baseline gap-2">
            <Icon name={s.icon} class="w-3.5 h-3.5 text-accent translate-y-px" />
            <dt class="text-sm text-ink-soft">{s.label}</dt>
            <dd class="font-serif font-bold text-lg">{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    pins.length > 0 && (
      <section class="mt-10">
        <div class="flex items-baseline justify-between mb-3">
          <h2 class="font-serif text-xl font-bold">다녀온 곳</h2>
          <a href="/map/" class="text-sm text-accent hover:underline">전체 지도 →</a>
        </div>
        {/* 스크롤로 보일 때만 불러온다 — 지도 JS 가 첫 화면 속도를 깎지 않게 */}
        <MapView pins={pins} height={340} client:visible />
      </section>
    )
  }

  <section class="mt-14 max-w-(--container-measure) mx-auto">
    <h2 class="font-serif text-xl font-bold mb-5">최근 글</h2>
    {featured && <PostCard post={featured} featured />}
    {rest.map((p) => <PostCard post={p} />)}
    {posts.length === 0 && <p class="text-ink-soft">아직 글이 없습니다.</p>}
  </section>
</Base>
