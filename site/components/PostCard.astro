---
import { Icon } from 'astro-icon/components';
import ExhibitionBadge from './ExhibitionBadge.astro';
import { formatShort, isEnded, type Post } from '../lib/posts';
import { categoryByName } from '../consts';

interface Props {
  post: Post;
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
const d = post.data;
const cat = categoryByName(d.category);
const faded = isEnded(post);

const meta = [
  d.heritage?.[0]?.type,
  d.heritage?.[0]?.era,
  d.exhibition?.map((e) => e.museum).join(' · '),
  d.location && [d.location.region.do, d.location.region.city].filter(Boolean).join(' '),
].filter(Boolean) as string[];
---

<article
  class:list={[
    'group border-b border-rule pb-6 mb-6 last:border-0',
    faded && 'opacity-65 hover:opacity-100 transition-opacity',
  ]}
>
  <a href={`/posts/${post.id}/`} class="block no-underline">
    <div class:list={['flex gap-4', featured ? 'flex-col' : 'flex-row-reverse']}>
      {
        d.cover && (
          <img
            src={d.cover}
            alt={d.coverAlt ?? ''}
            loading="lazy"
            decoding="async"
            class:list={[
              'rounded border border-rule object-cover bg-paper-raised',
              featured ? 'w-full aspect-[16/9]' : 'w-24 h-24 sm:w-32 sm:h-24 shrink-0',
            ]}
          />
        )
      }

      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap text-xs text-ink-soft mb-1.5">
          {cat && (
            <span class="flex items-center gap-1 text-accent font-bold">
              <Icon name={cat.icon} class="w-3 h-3" />
              {cat.name}
            </span>
          )}
          <time datetime={d.date.toISOString()}>{formatShort(d.date)}</time>
          <ExhibitionBadge post={post} />
        </div>

        <h2
          class:list={[
            'font-serif font-bold text-ink group-hover:text-accent transition-colors leading-snug',
            featured ? 'text-2xl' : 'text-lg',
          ]}
        >
          {d.title}
        </h2>

        {d.description && <p class="mt-1.5 text-sm text-ink-soft line-clamp-2">{d.description}</p>}

        {
          meta.length > 0 && (
            <p class="mt-2 text-xs text-ink-faint flex items-center gap-1.5 flex-wrap">
              {d.access?.primary === 'transit' ? (
                <Icon name="fa6-solid:train-subway" class="w-3 h-3" />
              ) : (
                <Icon name="fa6-solid:car" class="w-3 h-3" />
              )}
              {meta.join(' · ')}
            </p>
          )
        }
      </div>
    </div>
  </a>
</article>
